      "checkConstraints": {
        "tasks_status_ck": {
          "name": "tasks_status_ck",
          "value": "\"tasks\".\"status\" IN ('todo','in_progress','waiting','done','cancelled')"
        },
        "tasks_priority_ck": {
          "name": "tasks_priority_ck",
          "value": "\"tasks\".\"priority\" IN ('none','low','medium','high')"
        },
        "tasks_responsible_kind_ck": {
          "name": "tasks_responsible_kind_ck",
          "value": "\"tasks\".\"responsible_kind\" IN ('self','contact')"
        },
        "tasks_action_kind_ck": {
          "name": "tasks_action_kind_ck",
          "value": "\"tasks\".\"action_kind\" IN ('self','contact','none')"
        },
        "tasks_responsible_contact_ck": {
          "name": "tasks_responsible_contact_ck",
          "value": "(\"tasks\".\"responsible_kind\" = 'contact' AND \"tasks\".\"responsible_contact_id\" IS NOT NULL) OR (\"tasks\".\"responsible_kind\" = 'self' AND \"tasks\".\"responsible_contact_id\" IS NULL)"
        },
        "tasks_action_contact_ck": {
          "name": "tasks_action_contact_ck",
          "value": "(\"tasks\".\"action_kind\" = 'contact' AND \"tasks\".\"action_contact_id\" IS NOT NULL) OR (\"tasks\".\"action_kind\" != 'contact' AND \"tasks\".\"action_contact_id\" IS NULL)"
        },
        "tasks_done_ts_ck": {
          "name": "tasks_done_ts_ck",
          "value": "(\"tasks\".\"status\" = 'done' AND \"tasks\".\"completed_at\" IS NOT NULL AND \"tasks\".\"cancelled_at\" IS NULL) OR (\"tasks\".\"status\" != 'done' AND \"tasks\".\"completed_at\" IS NULL)"
        },
        "tasks_cancelled_ts_ck": {
          "name": "tasks_cancelled_ts_ck",
          "value": "(\"tasks\".\"status\" = 'cancelled' AND \"tasks\".\"cancelled_at\" IS NOT NULL AND \"tasks\".\"completed_at\" IS NULL) OR (\"tasks\".\"status\" != 'cancelled' AND \"tasks\".\"cancelled_at\" IS NULL)"
        }
      }
